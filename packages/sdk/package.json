{
  "name": "@ai-flight-recorder/sdk",
  "version": "0.1.0",
  "description": "SDK and provider adapters for AI Flight Recorder — wrap OpenAI, Anthropic, and Gemini clients to record AI sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "llm",
    "observability",
    "debugging",
    "recording",
    "sdk",
    "adapter",
    "openai",
    "anthropic",
    "gemini",
    "mcp",
    "flight-recorder"
  ],
  "author": "Matt Smith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllThingsSmitty/ai-flight-recorder.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/AllThingsSmitty/ai-flight-recorder#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-flight-recorder/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
