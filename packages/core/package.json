{
  "name": "@ai-flight-recorder/core",
  "version": "0.1.1",
  "description": "Core domain types and engine for AI Flight Recorder — record, replay, and inspect AI sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "llm",
    "observability",
    "debugging",
    "recording",
    "replay",
    "openai",
    "anthropic",
    "gemini",
    "mcp",
    "flight-recorder"
  ],
  "author": "Matt Smith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllThingsSmitty/ai-flight-recorder.git",
    "directory": "packages/core"
  },
  "homepage": "https://ai-flight-recorder.vercel.app",
  "bugs": {
    "url": "https://github.com/AllThingsSmitty/ai-flight-recorder/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
